# ========================================
# Gym Management System - Docker Environment Configuration
# ========================================
# Copy this file to .env and fill in your values
# Run: docker-compose up --build

# ----------------------------------------
# Database Configuration
# ----------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=n8n

# ----------------------------------------
# Security / Authentication
# ----------------------------------------
# CHANGE THIS: Use a strong secret for JWT tokens
JWT_PASS=your_secure_jwt_secret_here

# ----------------------------------------
# Email Configuration (Brevo/Sendinblue SMTP)
# ----------------------------------------
SMTP_USER=your_smtp_user@smtp-brevo.com
SMTP_PASS=your_smtp_password
SENDER_EMAIL=your_sender_email@gmail.com

# ----------------------------------------
# AI Service (OpenRouter)
# ----------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key

# ----------------------------------------
# Evolution API (WhatsApp)
# ----------------------------------------
EVOLUTION_API_KEY=mySecretGlobalApiKey123

# ----------------------------------------
# n8n Configuration
# ----------------------------------------
# The hostname where n8n is accessible (for webhook URLs)
N8N_HOST=localhost
